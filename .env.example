# ---------------------------------------------------------------------------
# Chess Hub — copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080
# Public origin of the app. Used to build absolute URLs in emails.
APP_URL=http://localhost:8080

# --- Database --------------------------------------------------------------
# MongoDB 7+. Run ./scripts/mongo-dev.sh start for a local single-node replica
# set (a replica set is what makes multi-document transactions available).
MONGODB_URI="mongodb://127.0.0.1:27017/chess_hub?replicaSet=rs0"

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# bcrypt work factor. 12 is a good 2020s default; raise it, never lower it.
BCRYPT_ROUNDS=12

# --- CORS ------------------------------------------------------------------
# Comma-separated origins allowed to call the API from another host. Leave
# empty when the SPA is served by this server (same origin) — the safe default.
# Never use "*" in production.
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting ---------------------------------------------------------
# Requests per window per IP for the global limiter.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Set to 1 when running behind a reverse proxy so client IPs are read from
# X-Forwarded-For. Leave 0 otherwise: trusting it blindly lets clients spoof
# their IP and slip past every rate limit.
TRUST_PROXY=0

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# --- Chess -----------------------------------------------------------------
DEFAULT_RATING=1200
PROVISIONAL_GAMES=10

# --- Transactional email (Brevo) -------------------------------------------
# Leave BREVO_API_KEY empty in development: OTP codes are then logged to the
# console instead of being emailed.
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@chesshub.local
BREVO_FROM_NAME=Chess Hub

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
