DATABASE_URL=mysql+pymysql://username:password@localhost:3306/chess_db
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret

# Rate limiting (optional)
RATELIMIT_DEFAULT=200 per minute
RATELIMIT_STORAGE_URI=memory://

# Brevo (Sendinblue) transactional email — used for user registration OTP emails.
# Leave BREVO_API_KEY empty to fall back to console output (dev only).
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@chesshub.local
BREVO_FROM_NAME=Chess Hub

# Set to "production" to enable secure cookies and stricter HTTPS settings
FLASK_ENV=development
