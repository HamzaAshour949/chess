APP_NAME="Chess Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Comma-separated origins allowed to call /api/* from a different host.
# Leave empty when the SPA is served by Laravel itself (same origin).
CORS_ALLOWED_ORIGINS=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# MySQL 8+ with utf8mb4 is the supported production target.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chess_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Chess platform -----------------------------------------------------
# Starting Elo for a brand-new account.
CHESS_DEFAULT_RATING=1200
# Games below this count use the provisional (high) K-factor.
CHESS_PROVISIONAL_GAMES=10
# API token lifetime in minutes (null = never expires).
AUTH_TOKEN_TTL_MINUTES=43200

# --- Transactional email (Brevo) ----------------------------------------
# Leave BREVO_API_KEY empty in development: OTP emails are then written to
# storage/logs/laravel.php instead of being sent.
MAIL_MAILER=log
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@chesshub.local
BREVO_FROM_NAME="Chess Hub"

MAIL_FROM_ADDRESS="no-reply@chesshub.local"
MAIL_FROM_NAME="${APP_NAME}"
