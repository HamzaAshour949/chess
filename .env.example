# ---------------------------------------------------------------------------
# Chess Hub — copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8080
# Where people open the site: links in emails, the PGN "Site" tag and the
# seed summary are built from it. In development that is the Vite dev server
# on :3000; after `bun run build && bun run start` it is :8080; in production,
# your public https:// origin.
APP_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# MongoDB 7+. Run `bun run db:start` for a local single-node replica set (a
# replica set is what makes multi-document transactions available).
MONGODB_URI="mongodb://127.0.0.1:27017/chess_hub?replicaSet=rs0"
# Bring indexes in line with the schemas on boot. Several are constraints the
# code relies on. Set to 0 if a release step runs `bun run db:indexes` instead.
DB_SYNC_INDEXES=1

# --- Auth ------------------------------------------------------------------
# Generate with: bun -e "console.log(crypto.getRandomValues(new Uint8Array(48)).toHex())"
# or: openssl rand -hex 48
# Production refuses to start with this placeholder.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# bcrypt work factor. 12 is a good 2020s default; raise it, never lower it.
BCRYPT_ROUNDS=12

# --- CORS ------------------------------------------------------------------
# Comma-separated origins allowed to call the API from another host. Leave
# empty when the SPA is served by this server (same origin) — the safe default.
# Never use "*" in production.
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting ---------------------------------------------------------
# Requests per window per IP for the global limiter.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Set to 1 when running behind a reverse proxy so client IPs are read from
# X-Forwarded-For. Leave 0 otherwise: trusting it blindly lets clients spoof
# their IP and slip past every rate limit.
TRUST_PROXY=0

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# --- Chess -----------------------------------------------------------------
DEFAULT_RATING=1200
PROVISIONAL_GAMES=10
# Each side's first move is free of the clock but must come within this many
# seconds, or the game is aborted with no result.
FIRST_MOVE_TIMEOUT_SECONDS=45
# Open challenges nobody accepted are withdrawn after this many minutes.
CHALLENGE_TTL_MINUTES=30

# --- Transactional email (Brevo) -------------------------------------------
# Leave BREVO_API_KEY empty in development: codes are then logged to the
# console instead of being emailed. Production refuses to start without a key
# unless EMAIL_CONSOLE=1 is set deliberately.
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@chesshub.local
BREVO_FROM_NAME=Chess Hub
EMAIL_CONSOLE=0

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# --- Docker Compose --------------------------------------------------------
# docker-compose.yml reads these instead of APP_URL and CORS_ORIGINS, so the
# development values above never leak into a container.
# PRODUCTION_APP_URL=https://chess.example.com
# PRODUCTION_CORS_ORIGINS=
