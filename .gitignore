# Dependencies
node_modules/
# Bun owns the lockfile; an npm or yarn one would drift from bun.lock.
package-lock.json
yarn.lock

# Build output
dist/
build/
server/dist/
frontend/dist/
*.tsbuildinfo

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Local MongoDB data directory (created by scripts/mongo-dev.sh)
.mongo-data/

# User uploads (keep the directory, ignore the contents)
uploads/*
!uploads/.gitkeep

# Logs
*.log
logs/

# Test / tooling caches
coverage/
.eslintcache

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# Uploads written by the test suite
.test-uploads/
