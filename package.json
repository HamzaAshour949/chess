{
  "name": "chess-hub",
  "version": "2.1.0",
  "private": true,
  "description": "Bilingual (EN/AR) chess players & news CMS plus a real-time multiplayer chess platform.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "server",
    "frontend"
  ],
  "scripts": {
    "up": "bun scripts/up.ts",
    "setup": "bun install && bun run db:start && bun run db:seed",
    "db:start": "./scripts/mongo-dev.sh start",
    "db:stop": "./scripts/mongo-dev.sh stop",
    "db:status": "./scripts/mongo-dev.sh status",
    "db:seed": "bun run --cwd server db:seed",
    "db:indexes": "bun run --cwd server db:indexes",
    "db:repair": "bun run --cwd server db:repair",
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun run --cwd server dev",
    "dev:web": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "start": "bun run --cwd server start",
    "test": "bun run --cwd server test",
    "typecheck": "bun run --cwd server typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.21.0"
  },
  "trustedDependencies": [
    "sharp"
  ],
  "overrides": {
    "bson": "7.2.0"
  }
}
