{
  "name": "@chess-hub/server",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "start": "bun --env-file=../.env src/index.ts",
    "db:seed": "bun --env-file=../.env src/db/seed.ts",
    "db:indexes": "bun --env-file=../.env src/db/sync-indexes.ts",
    "db:repair": "bun --env-file=../.env src/db/repair-games.ts",
    "test": "bun test --timeout=20000",
    "test:watch": "bun test --timeout=20000 --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3"
  }
}
